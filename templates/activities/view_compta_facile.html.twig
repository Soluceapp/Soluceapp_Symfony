{% extends 'base.html.twig' %} 


{% block body %}

<style>
/* Tableaux */
table {
  width: 100%;
  border-collapse: collapse;
  background-color: #222; /* fond du tableau */
  color: #fff;            /* texte blanc */
  margin: 1rem 0;
  border: 1px solid #444;
}

thead {
  background-color: #333;
}

th, td {
  padding: 10px;
  border: 1px solid #444;
  text-align: left;
}

tr:nth-child(even) {
  background-color: #2c2c2c; /* ligne sur deux pour visibilité */
}

tr:hover {
  background-color: #444;
}

.container-flex-article {
  display: flex;
  flex-direction: column;
  align-items: center;
  background-color: #1e1e1e;
  padding: 2rem;
  border-radius: 12px;
  box-shadow: 0 0 15px rgba(0,0,0,0.5);
  color: #fff;
  max-width: 600px;
  margin: auto;
}

form {
  width: 100%;
}

form div {
  margin-bottom: 1rem;
}

input[type="text"],
input[type="number"],
select,
textarea {
  width: 100%;
  padding: 10px;
  background-color: #2c2c2c;
  border: 1px solid #555;
  border-radius: 8px;
  color: #fff;
}

input:focus,
select:focus,
textarea:focus {
  border-color: #778cff;
  outline: none;
}

.dropbtn {
  padding: 12px 18px;
  font-size: 16px;
  cursor: pointer;
  background-color: rgba(34, 31, 179, 0.8);
  border: 2px solid rgba(55, 131, 231, 0.5);
  color: #fff;
  border-radius: 10px;
  transition: background-color 0.3s ease, transform 0.2s ease;
  width: 100%;
  margin-top: 1rem;
}

.dropbtn:hover {
  background-color: rgb(92, 45, 181);
  transform: scale(1.02);
}

</style>

<div   class="container-grid-maitre" > 
<!-- Contenu informatif de la page -->
<main>
<section class="style2">

<div style="margin:20px"><div class="style25">
<h1>Gestion Test</h1>

</div></div>
<article >

<!-- Explications principales -->

<div class="container-flex-article" style="display: flex; flex-direction: column; align-items: center;">
    {% if contexte.scenarios is not empty %}
        {{ form_start(contexte.form) }}
            {{ form_widget(contexte.form) }}
            <button class="dropbtn">Enregistrer</button>
        {{ form_end(contexte.form) }}
    {% endif %}
</div> 

<div class="container-flex-article">
{% if contexte.scenarios is not empty %}
    <table class="table table-dark table-bordered mt-4">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nom</th>
            </tr>
        </thead>
        <tbody>
            {% for scenario in contexte.scenarios %}
                <tr>
                    <td>{{ scenario.id }}</td>
                    <td>{{ scenario.nameScenario }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% else %}
    <p>Aucun scénario enregistré.</p>
{% endif %}

</div><br><br>


</article>


<br>


<br><br>
</section>
</main>




</div>
{% endblock %}
